# Copy this file to ".env" and fill in real values.
# The real ".env" is git-ignored so your password never gets committed.
#
# In GitHub Actions we won't use this file at all — we'll set these
# same names as encrypted repository "Secrets" (Module 8).

# The Gmail address the tool sends FROM (and, for now, TO).
EMAIL_ADDRESS=you@gmail.com

# A Google "App Password" (16 chars, NOT your normal Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where to send the digest (can be the same as EMAIL_ADDRESS).
EMAIL_TO=you@gmail.com
